model Course {
  id             String   @id @default(cuid())
  code           String
  title          String
  creditHours    Int

  programId      String
  program        Program  @relation(fields: [programId], references: [id])

  // prerequisites THIS course requires
  prerequisites  CoursePrerequisite[] @relation("CourseRequires")
  // courses that require THIS course as a prerequisite
  requiredFor    CoursePrerequisite[] @relation("RequiredByCourse")

  sections       Section[]

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  deletedAt      DateTime?

  @@unique([programId, code])
  @@index([programId])
  @@map("courses")
}