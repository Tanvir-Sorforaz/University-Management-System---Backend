model Exam {
  id             String       @id @default(cuid())

  sectionId      String
  section        Section      @relation(fields: [sectionId], references: [id])

  title          String
  type           ExamType
  examDate       DateTime
  totalMarks     Float
  weightPercent  Float        // contribution to final grade

  results        ExamResult[]

  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  deletedAt      DateTime?

  @@index([sectionId])
  @@map("exams")
}